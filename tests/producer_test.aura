// ==============================================================================
// Apache Kafka for Aura Language (AuraKafka)
// tests/producer_test.aura - Unit Tests for KafkaProducer Client
// ==============================================================================

import { Record } from "../storage/record";
import { PartitionLog } from "../storage/partition_log";
import { LogManager } from "../storage/log_manager";
import { GroupCoordinator } from "../coordinator/coordinator";
import { KRaftController } from "../coordinator/kraft";
import { KafkaServerConfig } from "../server/config";
import { ReplicaManager } from "../server/replica_manager";
import { KafkaBroker, NewDefaultBroker } from "../server/broker";
import {
  KafkaProducer,
  NewKafkaProducer,
  NewProducerRecord,
  NewProducerRecordWithPartition,
  HashPartition
} from "../client/producer";
import { NewDefaultProducerConfig } from "../client/config";

export fn main(): Unit => {
  let mut passed = 0;
  let mut failed = 0;

  println("================================================================================");
  println("  🧪 AURAKAFKA - PRODUCER CLIENT UNIT TESTS");
  println("================================================================================");

  let mut broker = NewDefaultBroker(1, 9092);
  broker.Startup();

  let pCfg = NewDefaultProducerConfig();
  let mut producer = NewKafkaProducer(pCfg, broker);

  // Test 1: Consistent Key Hash Partitioning
  println("\n[TEST 1] Consistent Key Hash Partitioning");
  let pA1 = HashPartition("customer-99", 5);
  let pA2 = HashPartition("customer-99", 5);
  let pB = HashPartition("customer-100", 5);

  if (pA1 == pA2 && pA1 >= 0 && pA1 < 5) {
    println(`  ✓ PASS: Key 'customer-99' deterministically hashes to partition ${pA1}`);
    passed += 1;
  } else {
    println("  ✕ FAIL: Key hash partitioning non-deterministic");
    failed += 1;
  };

  // Test 2: Synchronous Send & RecordMetadata
  println("\n[TEST 2] Synchronous Send & Offset Assignment");
  let rec1 = NewProducerRecord("sensor-data", "temp-1", "{\"reading\": 24.5}");
  let sendRes1 = producer.Send(rec1);

  match sendRes1 {
    Ok(meta) => {
      if (meta.topic == "sensor-data" && meta.offset == 0) {
        println(`  ✓ PASS: Sent record to ${meta.topic} [part ${meta.partition}] with baseOffset ${meta.offset}`);
        passed += 1;
      } else {
        println("  ✕ FAIL: Metadata offset or topic mismatch");
        failed += 1;
      };
    },
    Err(e) => {
      println(`  ✕ FAIL: Send failed with error: ${e}`);
      failed += 1;
    }
  };

  // Test 3: Multiple Sequential Sends & Monotonic Offsets
  println("\n[TEST 3] Multiple Sequential Sends to Partition");
  let sendRes2 = producer.Send(NewProducerRecordWithPartition("sensor-data", 0, "fixed-key", "msg-1"));
  let sendRes3 = producer.Send(NewProducerRecordWithPartition("sensor-data", 0, "fixed-key", "msg-2"));

  match sendRes2 {
    Ok(m2) => {
      match sendRes3 {
        Ok(m3) => {
          if (m3.offset == m2.offset + 1 && m2.partition == 0 && m3.partition == 0) {
            println(`  ✓ PASS: Consecutive writes assigned sequential offsets (${m2.offset} -> ${m3.offset})`);
            passed += 1;
          } else {
            println("  ✕ FAIL: Sequential offset check failed");
            failed += 1;
          };
        },
        Err(e) => {
          println(`  ✕ FAIL: Second send error: ${e}`);
          failed += 1;
        }
      };
    },
    Err(e) => {
      println(`  ✕ FAIL: First send error: ${e}`);
      failed += 1;
    }
  };

  broker.Shutdown();

  println("--------------------------------------------------------------------------------");
  println(`  📊 RESULTS: ${passed} PASSED | ${failed} FAILED`);
  println("================================================================================");
}
