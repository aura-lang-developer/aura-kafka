// ==============================================================================
// Apache Kafka for Aura Language (AuraKafka)
// tests/e2e_cluster_test.aura - End-to-End Complete Kafka Lifecycle Test
// ==============================================================================

import { KafkaBroker, NewDefaultBroker } from "../server/broker";
import { AdminClient, NewAdminClient, MakeNewTopic } from "../client/admin";
import { KafkaProducer, NewKafkaProducer, NewProducerRecord } from "../client/producer";
import { KafkaConsumer, NewKafkaConsumer } from "../client/consumer";
import { NewDefaultProducerConfig, NewDefaultConsumerConfig } from "../client/config";

export fn main(): Unit => {
  let mut passed = 0;
  let mut failed = 0;

  println("================================================================================");
  println("  🚀 AURAKAFKA - END-TO-END CLUSTER & PUB/SUB LIFECYCLE TEST");
  println("================================================================================");

  // 1. Cluster Initialization
  println("\n[PHASE 1] Initializing KRaft Broker & Controller");
  let mut broker = NewDefaultBroker(101, 9092);
  broker.Startup();

  if (broker.isRunning && broker.kraft.IsLeader(101)) {
    println("  ✓ PASS: Broker-101 started and elected as active KRaft controller");
    passed += 1;
  } else {
    println("  ✕ FAIL: Broker startup failed");
    failed += 1;
  };

  // 2. Admin Topic Creation
  println("\n[PHASE 2] AdminClient Topic Creation & Discovery");
  let mut admin = NewAdminClient(broker);
  let topicName = "payment-transactions";
  let createRes = admin.CreateTopics([MakeNewTopic(topicName, 3, 1)]);

  match createRes {
    Ok(ok) => {
      let desc = admin.DescribeTopics([topicName]);
      if (ok && len(desc) == 1 && len(desc[0].partitions) == 3) {
        println(`  ✓ PASS: Topic '${topicName}' created with 3 partitions`);
        passed += 1;
      } else {
        println("  ✕ FAIL: Topic description validation failed");
        failed += 1;
      };
    },
    Err(e) => {
      println(`  ✕ FAIL: Topic creation failed: ${e}`);
      failed += 1;
    }
  };

  // 3. Producer Publishing
  println("\n[PHASE 3] Producer Message Publishing with Key Hash Partitioning");
  let pCfg = NewDefaultProducerConfig();
  let mut producer = NewKafkaProducer(pCfg, broker);

  let pRes1 = producer.Send(NewProducerRecord(topicName, "user_1001", "{\"amount\": 150.00, \"currency\": \"USD\"}"));
  let pRes2 = producer.Send(NewProducerRecord(topicName, "user_1002", "{\"amount\": 2500.50, \"currency\": \"EUR\"}"));
  let pRes3 = producer.Send(NewProducerRecord(topicName, "user_1003", "{\"amount\": 89.90, \"currency\": \"GBP\"}"));
  let pRes4 = producer.Send(NewProducerRecord(topicName, "user_1001", "{\"amount\": 45.00, \"currency\": \"USD\"}"));

  let mut sendsSuccess = false;
  match pRes1 {
    Ok(m1) => {
      match pRes2 {
        Ok(m2) => {
          match pRes3 {
            Ok(m3) => {
              match pRes4 {
                Ok(m4) => {
                  sendsSuccess = true;
                  println(`  ✓ PASS: 4 records published across partitions (Offsets: [P${m1.partition}:${m1.offset}, P${m2.partition}:${m2.offset}, P${m3.partition}:${m3.offset}, P${m4.partition}:${m4.offset}])`);
                  passed += 1;
                },
                Err(e) => { failed += 1; }
              };
            },
            Err(e) => { failed += 1; }
          };
        },
        Err(e) => { failed += 1; }
      };
    },
    Err(e) => { failed += 1; }
  };

  if (!sendsSuccess) {
    println("  ✕ FAIL: One or more producer sends failed");
  };

  // 4. Consumer Group Consumption & Commit
  println("\n[PHASE 4] Consumer Group Join, Subscription & Polling");
  let mut cCfg = NewDefaultConsumerConfig("payments-processor");
  cCfg.autoOffsetReset = "earliest";
  let mut consumer = NewKafkaConsumer(cCfg, broker);

  consumer.Subscribe([topicName]);
  let records = consumer.Poll(1000);

  if (len(records) == 4) {
    println(`  ✓ PASS: Consumer joined group '${cCfg.groupId}', assigned 3 partitions and polled all 4 records`);
    passed += 1;
  } else {
    println(`  ✕ FAIL: Expected 4 records, polled ${len(records)}`);
    failed += 1;
  };

  // 5. Commit Offsets & Re-poll
  println("\n[PHASE 5] Offset Commit & Idempotent Re-poll");
  consumer.CommitSync();

  // Subsequent poll should return 0 new records since offsets were committed
  let emptyRecords = consumer.Poll(500);
  if (len(emptyRecords) == 0) {
    println("  ✓ PASS: Subsequent poll returned 0 new records (offsets up to date)");
    passed += 1;
  } else {
    println(`  ✕ FAIL: Expected 0 records after commit, received ${len(emptyRecords)}`);
    failed += 1;
  };

  // 6. Cluster Teardown
  println("\n[PHASE 6] Clean Shutdown");
  consumer.Close();
  broker.Shutdown();

  if (!broker.isRunning) {
    println("  ✓ PASS: Consumer left group and broker shutdown completed cleanly");
    passed += 1;
  } else {
    println("  ✕ FAIL: Broker shutdown failed");
    failed += 1;
  };

  println("--------------------------------------------------------------------------------");
  println(`  📊 RESULTS: ${passed} PASSED | ${failed} FAILED`);
  println("================================================================================");
}
