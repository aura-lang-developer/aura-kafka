// ==============================================================================
// Apache Kafka for Aura Language (AuraKafka)
// cli.aura - Unified Standalone CLI & Command Dispatcher
// ==============================================================================

import { PrintBanner } from "./kafka";
import { KafkaBroker, NewDefaultBroker } from "./server/broker";
import { AdminClient, NewAdminClient, MakeNewTopic } from "./client/admin";
import { KafkaProducer, NewKafkaProducer, NewProducerRecord } from "./client/producer";
import { KafkaConsumer, NewKafkaConsumer } from "./client/consumer";
import { NewDefaultProducerConfig, NewDefaultConsumerConfig } from "./client/config";

fn runServer(): Unit => {
  PrintBanner();
  println("🚀  AuraKafka Broker Server Daemon (KRaft Mode)");
  println("--------------------------------------------------");

  let mut broker = NewDefaultBroker(1, 9092);
  broker.Startup();

  println("\n[SERVER] Broker active and ready for client connections.");
  println("  • KRaft Quorum Controller: Enabled");
  println("  • HighWatermark Manager: Active");
  println("  • Group Coordinator: Active");
  println("  • Storage Engine: Active");

  println("\n[SERVER] Executing health check...");
  if broker.isRunning {
    println("  ✓ Broker status: HEALTHY (Cluster Quorum Ready)");
  };

  broker.Shutdown();
  println("✓ Server stopped.");
}

fn runTopics(): Unit => {
  PrintBanner();
  println("🛠️  AuraKafka Topics CLI (kafka-topics)");
  println("--------------------------------------------------");

  let mut broker = NewDefaultBroker(1, 9092);
  broker.Startup();

  let mut admin = NewAdminClient(broker);

  // 1. Create Topics
  println("\n[ACTION] Creating topics: 'orders-stream' (3 partitions), 'user-events' (2 partitions)...");
  let t1 = MakeNewTopic("orders-stream", 3, 1);
  let t2 = MakeNewTopic("user-events", 2, 1);
  let res = admin.CreateTopics([t1, t2]);
  match res {
    Ok(_) => println("  ✓ Topics created successfully!"),
    Err(e) => println(`  ✕ Error: ${e}`)
  };

  // 2. List Topics
  println("\n[ACTION] Listing topics:");
  let topics = admin.ListTopics();
  let mut i = 0;
  while i < len(topics) {
    println(`  • Topic: ${topics[i]}`);
    i += 1;
  };

  // 3. Describe Topics
  println("\n[ACTION] Describing topic 'orders-stream':");
  let descs = admin.DescribeTopics(["orders-stream"]);
  let mut dIdx = 0;
  while dIdx < len(descs) {
    let d = descs[dIdx];
    println(`  Topic: ${d.name} (Partitions: ${len(d.partitions)})`);
    let mut pIdx = 0;
    while pIdx < len(d.partitions) {
      let p = d.partitions[pIdx];
      println(`    Partition: ${p.partition} | Leader: ${p.leader} | Replicas: [${p.replicas[0]}] | Isr: [${p.isr[0]}]`);
      pIdx += 1;
    };
    dIdx += 1;
  };

  // 4. Cluster Description
  println("\n[ACTION] Cluster Metadata:");
  println(`  ${admin.DescribeCluster()}`);

  broker.Shutdown();
  println("\n✓ Topics CLI command completed successfully.");
}

fn runProducer(): Unit => {
  PrintBanner();
  println("📤  AuraKafka Console Producer (kafka-console-producer)");
  println("--------------------------------------------------");

  let mut broker = NewDefaultBroker(1, 9092);
  broker.Startup();

  let pCfg = NewDefaultProducerConfig();
  let mut producer = NewKafkaProducer(pCfg, broker);

  println("\n[PRODUCE] Publishing messages to topic 'quickstart-events'...");
  let messages = [
    { key: "user-101", value: "{\"event\":\"login\",\"timestamp\":1710000000}" },
    { key: "user-102", value: "{\"event\":\"page_view\",\"page\":\"/home\"}" },
    { key: "user-101", value: "{\"event\":\"purchase\",\"amount\":49.99}" },
    { key: "user-103", value: "{\"event\":\"logout\",\"session\":\"sess-987\"}" }
  ];

  let mut i = 0;
  while i < len(messages) {
    let m = messages[i];
    let record = NewProducerRecord("quickstart-events", m.key, m.value);
    let sendRes = producer.Send(record);
    match sendRes {
      Ok(meta) => {
        println(`  ✓ Produced to ${meta.topic} [partition ${meta.partition}] at offset ${meta.offset} (Key: ${m.key})`);
      },
      Err(e) => {
        println(`  ✕ Failed to produce message: ${e}`);
      }
    };
    i += 1;
  };

  producer.Flush();
  producer.Close();
  broker.Shutdown();
  println("\n✓ Console producer finished publishing.");
}

fn runConsumer(): Unit => {
  PrintBanner();
  println("📥  AuraKafka Console Consumer (kafka-console-consumer)");
  println("--------------------------------------------------");

  let mut broker = NewDefaultBroker(1, 9092);
  broker.Startup();

  // Populate sample records
  let pCfg = NewDefaultProducerConfig();
  let mut producer = NewKafkaProducer(pCfg, broker);
  producer.Send(NewProducerRecord("orders", "order-1", "{\"item\":\"laptop\",\"price\":1200}"));
  producer.Send(NewProducerRecord("orders", "order-2", "{\"item\":\"mouse\",\"price\":25}"));
  producer.Send(NewProducerRecord("orders", "order-3", "{\"item\":\"keyboard\",\"price\":80}"));

  // Consumer
  let mut cCfg = NewDefaultConsumerConfig("console-consumer-group");
  cCfg.autoOffsetReset = "earliest";
  let mut consumer = NewKafkaConsumer(cCfg, broker);

  println("\n[CONSUME] Subscribing to 'orders' (--from-beginning)...");
  consumer.Subscribe(["orders"]);

  let records = consumer.Poll(1000);
  println(`  ✓ Fetched ${len(records)} records:`);

  let mut i = 0;
  while i < len(records) {
    let r = records[i];
    println(`  [Offset: ${r.offset} | Partition: ${r.partition}] Key: ${r.key} => Value: ${r.value}`);
    i += 1;
  };

  consumer.Close();
  broker.Shutdown();
  println("\n✓ Console consumer finished reading.");
}

fn runDemo(): Unit => {
  PrintBanner();
  println("🚀 DEMO: End-to-End Distributed Pub/Sub Pipeline in Aura");
  println("==================================================");

  println("\n[STEP 1] Starting Kafka Broker (KRaft Controller Mode)...");
  let mut broker = NewDefaultBroker(101, 9092);
  broker.Startup();

  println("\n[STEP 2] AdminClient Provisioning Topic 'payments' (3 Partitions)...");
  let mut admin = NewAdminClient(broker);
  let res = admin.CreateTopics([MakeNewTopic("payments", 3, 1)]);
  match res {
    Ok(_) => println("  ✓ Topic 'payments' created."),
    Err(e) => println(`  ✕ Topic creation error: ${e}`)
  };

  println("\n[STEP 3] Producing Financial Transactions with Key-based Partitioning...");
  let pCfg = NewDefaultProducerConfig();
  let mut producer = NewKafkaProducer(pCfg, broker);

  let transactions = [
    { key: "acct-001", amount: 150.0 },
    { key: "acct-002", amount: 25.5 },
    { key: "acct-001", amount: 80.0 },
    { key: "acct-003", amount: 1200.0 },
    { key: "acct-002", amount: 310.0 },
    { key: "acct-004", amount: 95.0 }
  ];

  let mut i = 0;
  while i < len(transactions) {
    let t = transactions[i];
    let val = `{\"account\":\"${t.key}\",\"amount\":${t.amount}}`;
    let resSend = producer.Send(NewProducerRecord("payments", t.key, val));
    match resSend {
      Ok(meta) => {
        println(`  → [Partition ${meta.partition}] Offset ${meta.offset} | Key: ${t.key} | Amount: $${t.amount}`);
      },
      Err(err) => println(`  ✕ Send error: ${err}`)
    };
    i += 1;
  };

  println("\n[STEP 4] Consumers in Group 'fraud-detector-group' Processing Events...");
  let mut cCfg = NewDefaultConsumerConfig("fraud-detector-group");
  cCfg.autoOffsetReset = "earliest";
  let mut consumer = NewKafkaConsumer(cCfg, broker);

  consumer.Subscribe(["payments"]);
  let records = consumer.Poll(1000);
  println(`  ✓ Successfully fetched ${len(records)} transactions across all partitions.`);

  let mut j = 0;
  while j < len(records) {
    let r = records[j];
    println(`    ✓ [Part ${r.partition} | Off ${r.offset}] ${r.key} => ${r.value}`);
    j += 1;
  };

  println("\n[STEP 5] Clean Shutdown of Consumer, Producer, and Broker...");
  consumer.Close();
  producer.Close();
  broker.Shutdown();

  println("\n🎉 Event streaming demo completed successfully!");
}

fn runBenchmark(): Unit => {
  println("================================================================================");
  println("  ⚡ AURAKAFKA PERFORMANCE BENCHMARK");
  println("================================================================================");

  let startBoot = time.now();
  let mut broker = NewDefaultBroker(1, 9092);
  broker.Startup();
  let bootTime = time.now() - startBoot;
  println(`[BENCHMARK] Broker Cold Boot Time: ${bootTime} ms`);

  let pCfg = NewDefaultProducerConfig();
  let mut producer = NewKafkaProducer(pCfg, broker);
  let topic = "perf-test-topic";

  let count = 10000;
  let payload = "{\"event\":\"order_created\",\"amount\":99.99,\"user_id\":12345,\"timestamp\":1710000000}";
  println(`\n[BENCHMARK] Producing ${count} records synchronously...`);

  let startProduce = time.now();
  let mut i = 0;
  while i < count {
    let key = `k-${i % 100}`;
    producer.Send(NewProducerRecord(topic, key, payload));
    i += 1;
  };
  let produceTime = time.now() - startProduce;
  let produceDurationSec = if produceTime > 0 { produceTime / 1000.0 } else { 0.001 };
  let produceOpsPerSec = count / produceDurationSec;
  let bytesTotal = count * len(payload);
  let mbTotal = bytesTotal / (1024.0 * 1024.0);
  let produceMbPerSec = mbTotal / produceDurationSec;

  println(`  ✓ Produced: ${count} records in ${produceTime} ms`);
  println(`  ✓ Producer Throughput: ${produceOpsPerSec} msgs/sec (${produceMbPerSec} MB/sec)`);

  println(`\n[BENCHMARK] Consuming ${count} records with consumer group...`);
  let mut cCfg = NewDefaultConsumerConfig("bench-consumer-group");
  cCfg.autoOffsetReset = "earliest";
  let mut consumer = NewKafkaConsumer(cCfg, broker);

  consumer.Subscribe([topic]);

  let startConsume = time.now();
  let records = consumer.Poll(1000);
  let consumeTime = time.now() - startConsume;
  let consumedCount = len(records);
  let consumeDurationSec = if consumeTime > 0 { consumeTime / 1000.0 } else { 0.001 };
  let consumeOpsPerSec = consumedCount / consumeDurationSec;
  let consumeMbPerSec = (consumedCount * len(payload) / (1024.0 * 1024.0)) / consumeDurationSec;

  println(`  ✓ Consumed: ${consumedCount} records in ${consumeTime} ms`);
  println(`  ✓ Consumer Throughput: ${consumeOpsPerSec} msgs/sec (${consumeMbPerSec} MB/sec)`);

  broker.Shutdown();
  println("================================================================================");
}

fn printHelp(): Unit => {
  PrintBanner();
  println("AuraKafka Unified Command Line Interface (CLI)");
  println("Usage: aurakafka <command> [options]");
  println("");
  println("Available Commands:");
  println("  server     Start the Kafka Broker Server daemon (KRaft controller mode)");
  println("  topics     Create, list, describe, and inspect Kafka topics & partitions");
  println("  producer   Publish interactive console events to partitioned topics");
  println("  consumer   Consume events from partition logs with Consumer Groups");
  println("  demo       Execute complete end-to-end distributed pub/sub pipeline");
  println("  bench      Execute micro-benchmark measuring producer/consumer throughput");
  println("  help       Show this usage information and exit");
  println("");
  println("Examples:");
  println("  aurakafka server");
  println("  aurakafka topics");
  println("  aurakafka producer");
  println("  aurakafka consumer");
  println("  aurakafka demo");
  println("  aurakafka bench");
}

export fn main(): Unit => {
  let args = os.args;
  let envCmd = os.env("CMD");

  let cmd = if len(args) > 0 {
    args[0]
  } else if len(envCmd) > 0 {
    envCmd
  } else {
    "help"
  };

  match cmd {
    "server"   => runServer(),
    "topics"   => runTopics(),
    "producer" => runProducer(),
    "consumer" => runConsumer(),
    "demo"     => runDemo(),
    "bench"    => runBenchmark(),
    "help"     => printHelp(),
    _          => {
      println(`✕ Unknown command '${cmd}'. Run 'aurakafka help' for usage.`);
      printHelp();
    }
  };
}
