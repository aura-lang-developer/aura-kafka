// ==============================================================================
// Apache Kafka for Aura Language (AuraKafka)
// client/admin.aura - Kafka Admin Client API (Modern Functional Pipeline Edition)
// Based on org.apache.kafka.clients.admin.AdminClient
// ==============================================================================

import {
  CreateTopicsRequest,
  CreateTopicsRequestTopic,
  CreateTopicsResponse,
  CreateTopicsResponseTopic,
  DeleteTopicsRequest,
  DeleteTopicsResponse,
  DeleteTopicsResponseTopic,
  MetadataRequest,
  MetadataResponse,
  MetadataResponsePartition,
  MetadataResponseTopic
}from "../protocol/messages";
import {KafkaBroker}from "../server/broker";

/// Specifications for creating a new Kafka topic
export struct NewTopic {
  name: String,
  numPartitions: Int,
  replicationFactor: Int
};

export fn MakeNewTopic(name: String, numPartitions: Int, replicationFactor: Int): NewTopic => {
  return {
    name: name,
    numPartitions: numPartitions,
    replicationFactor: replicationFactor
  };
}

/// Partition description within topic metadata
export struct PartitionMetadata {
  partition: Int,
  leader: Int,
  replicas: []Int,
  isr: []Int
};

/// Full topic description
export struct TopicDescription {
  name: String,
  isInternal: Bool,
  partitions: []PartitionMetadata
};

/// Administrative client for managing topics, brokers, and cluster metadata
export struct AdminClient {
  broker: KafkaBroker
};

export fn NewAdminClient(broker: KafkaBroker): AdminClient => {
  return {broker: broker};
}

// ------------------------------------------------------------------------------
// Transformation Helpers (Pipeline Stages)
// ------------------------------------------------------------------------------

fn toCreateTopicsRequestTopic(t: NewTopic): CreateTopicsRequestTopic => {
  return {
    name: t.name,
    numPartitions: t.numPartitions,
    replicationFactor: t.replicationFactor
  };
}

fn toCreateTopicsRequest(topics: []NewTopic, timeoutMs: Int): CreateTopicsRequest => {
  return {
    topics: topics |> map(toCreateTopicsRequestTopic),
    timeoutMs: timeoutMs
  };
}

fn checkCreateTopicsResponse(resp: CreateTopicsResponse): Result<Bool, String> => {
  let errors = resp.topics |> filter(fn(t: CreateTopicsResponseTopic): Bool => {
    return t.errorCode != 0;
  });

  if len(errors)>0 {
    let err = errors[0];
    return Err(`Failed to create topic '${err.name}': ${err.errorMessage}`);
  };

  return Ok(true);
}

fn toDeleteTopicsRequest(topicNames: []String, timeoutMs: Int): DeleteTopicsRequest => {
  return {
    topicNames: topicNames,
    timeoutMs: timeoutMs
  };
}

fn checkDeleteTopicsResponse(resp: DeleteTopicsResponse): Result<Bool, String> => {
  let errors = resp.topics |> filter(fn(t: DeleteTopicsResponseTopic): Bool => {
    return t.errorCode != 0;
  });

  if len(errors)>0 {
    let err = errors[0];
    return Err(`Failed to delete topic '${err.name}' with error code ${err.errorCode}`);
  };

  return Ok(true);
}

fn toMetadataRequest(topicNames: []String): MetadataRequest => {
  return {
    topics: topicNames,
    allowAutoTopicCreation: false
  };
}

fn toPartitionMetadata(p: MetadataResponsePartition): PartitionMetadata => {
  return {
    partition: p.partitionIndex,
    leader: p.leaderId,
    replicas: p.replicaNodes,
    isr: p.isrNodes
  };
}

fn toTopicDescription(t: MetadataResponseTopic): TopicDescription => {
  return {
    name: t.name,
    isInternal: t.isInternal,
    partitions: t.partitions |> map(toPartitionMetadata)
  };
}

fn extractTopicDescriptions(resp: MetadataResponse): []TopicDescription => {
  return resp.topics |> map(toTopicDescription);
}

// ------------------------------------------------------------------------------
// AdminClient Methods
// ------------------------------------------------------------------------------

/// Creates new topics in the cluster using functional pipeline stages
fn(admin: * AdminClient)CreateTopics(topics: []NewTopic): Result<Bool, String> => {
  return topics
  |> toCreateTopicsRequest(30000)
  |> admin.broker.HandleCreateTopics
  |> checkCreateTopicsResponse;
}

/// Lists all existing topic names in the cluster
fn(admin: * AdminClient)ListTopics(): []String => {
  return admin.broker.logManager.AllTopics();
}

/// Describes metadata and partitions for given topic names using nested pipelines
fn(admin: * AdminClient)DescribeTopics(topicNames: []String): []TopicDescription => {
  return topicNames
  |> toMetadataRequest
  |> admin.broker.HandleMetadata
  |> extractTopicDescriptions;
}

/// Deletes topics by name using pipeline stages and error filtering
fn(admin: * AdminClient)DeleteTopics(topicNames: []String): Result<Bool, String> => {
  return topicNames
  |> toDeleteTopicsRequest(30000)
  |> admin.broker.HandleDeleteTopics
  |> checkDeleteTopicsResponse;
}

/// Returns a string describing cluster state
fn(admin: * AdminClient)DescribeCluster(): String => {
  return `Cluster ID: ${admin.broker.kraft.clusterId} | Active Controller: Broker-${admin.broker.kraft.leaderBrokerId} | Registered Brokers: ${admin.broker.kraft.NumBrokers()}`;
}
