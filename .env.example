# ==============================================================================
# AuraKafka Local Environment Variables (Example Template)
# ==============================================================================

# AuraKafka Web Management Portal & Observability Dashboard (Host Port)
AURAKAFKA_WEB_PORT=9095

# Apache Kafka External Broker Port
KAFKA_BROKER_PORT=9092

# Provectus Kafka UI Web Interface Port
KAFKA_UI_PORT=8080

# Confluent Schema Registry Port
SCHEMA_REGISTRY_PORT=8081

# Kafka Cluster Configuration
KAFKA_CLUSTER_ID=4L622nShTUiBENAzNu64UQ
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=1
